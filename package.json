{
  "name": "midespensa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "scripts": {
    "dev": "next dev",
    "dev:auth": "node scripts/dev-server.mjs --auth",
    "dev:demo": "node scripts/dev-server.mjs --demo",
    "dev:auth:mobile": "node scripts/dev-server.mjs --auth --mobile",
    "dev:demo:mobile": "node scripts/dev-server.mjs --demo --mobile",
    "dev:services": "node scripts/dev-services.mjs",
    "dev:reset": "npx supabase db reset",
    "dev:stop": "npx supabase stop",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e-auth.mjs",
    "test:e2e:founder": "node scripts/run-e2e-auth.mjs e2e/founder-journey.spec.ts",
    "test:e2e:actions": "node scripts/run-e2e-auth.mjs e2e/founder-actions.spec.ts",
    "test:e2e:realtime": "node scripts/run-e2e-auth.mjs e2e/founder-realtime.spec.ts",
    "test:e2e:ux": "node scripts/run-e2e-ux.mjs",
    "test:e2e:responsive": "playwright test e2e/responsive-navigation.spec.ts",
    "snapshot:ui": "node scripts/capture-visual-context.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "next": "16.2.10",
    "pdfjs-dist": "^5.4.624",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
